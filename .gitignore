# Dependencies
node_modules/

# packages/*/lib is committed so a git or npm install ships the runtime
# entry points. tsc incremental state stays ignored; a `pnpm build` must
# leave the tracked lib output clean.
packages/*/tsconfig.tsbuildinfo

# Generated client bundle intermediate (scripts/build-client.mjs)
dsh/.build/

# Test output
coverage/

# Editor / OS noise
.idea/
.DS_Store

# Logs
*.log

# Local act inputs (--env-file / --secret-file); never commit them
.env
.secrets
