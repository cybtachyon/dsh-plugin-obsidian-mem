# Dependencies
node_modules/

# packages/*/lib is committed so a git or npm install ships the runtime
# entry points. tsc incremental state stays ignored; a `pnpm build` must
# leave the tracked lib output clean.
packages/*/tsconfig.tsbuildinfo

# One-off throwaway typecheck recipes (tsc over the tests tier) can drop
# extra tsbuildinfo files next to the tracked lib output; they are state,
# never artifacts.
packages/*/lib/tsconfig*.tsbuildinfo

# Generated client bundle intermediate (scripts/build-client.mjs)
dsh/.build/

# Test output
coverage/

# Eval harness result blobs (scripts/eval/recall-eval.mjs); commit a
# specific baseline deliberately with --out, not the whole directory
scripts/eval/results/

# Editor / OS noise
.idea/
.DS_Store

# Logs
*.log

# Local act inputs (--env-file / --secret-file); never commit them
.env
.secrets
