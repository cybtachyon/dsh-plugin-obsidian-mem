{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    // The card is browser-only: its components need the DOM event and
    // element types. @types/node web globals are written to coexist with
    // lib.dom.
    "lib": ["es2024", "dom"],
    // The card renders with the classic JSX transform: react and the
    // primitives resolve at runtime through the shell's frozen platform
    // module table, so the automatic runtime (react/jsx-runtime) is not
    // available and must not be emitted. The factory names match
    // scripts/build-client.mjs (the bundle's esbuild jsx settings mirror
    // these).
    "jsx": "react",
    "jsxFactory": "react.createElement",
    "jsxFragmentFactory": "react.Fragment"
  },
  "include": ["src"],
  // Type-only cross-package imports (route payload types, vault mode): the
  // bundle never imports these values (they would drag node builtins into
  // the browser), but tsc needs the declaration outputs to be built first,
  // which is exactly what references order.
  "references": [
    { "path": "../core" },
    { "path": "../service" },
    { "path": "../ui" }
  ]
}
