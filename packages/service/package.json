{
  "name": "dsh-plugin-obsidian-mem-service",
  "version": "0.0.1",
  "description": "Service Definition for the dsh Obsidian Mem capability seam (ctx.obsidianMem): the vault registry, embedder, Milvus-Lite lifecycle, indexer manager, hybrid search, and the audit/dream compaction engine behind the memory_* tools",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "memory",
    "milvus",
    "embeddings",
    "service"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@zilliz/milvus2-sdk-node": "^3.0.6"
  }
}
